            ? "Boss Chamber"
            : (rooms != null && currentRoomIndex < rooms.Count && rooms[currentRoomIndex].activeRoute != null
                ? rooms[currentRoomIndex].activeRoute.title
                : "Entrance Chamber");

        var track = new System.Text.StringBuilder();
        for (int i = 0; i < totalR; i++)
        {
