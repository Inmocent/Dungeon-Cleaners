using UnityEngine;
using System.Collections.Generic;

/// <summary>
/// Defines which character sprite prefix maps to each hero or enemy type.
/// </summary>
public static class SpriteMapping
{
    // Hero sprite prefixes (used by CharacterAnimator)
    // These map to file patterns like: knight_m_idle_anim_f0, knight_m_run_anim_f0, etc.
    private static readonly Dictionary<string, string> heroSpriteMap = new()
    {
        { "Knight Alden", "knight_m" },
        { "Knight Cedric", "knight_f" },
        { "Mage Rowan", "wizzard_m" },
        { "Mage Vesper", "wizzard_f" },
        { "Healer Lynne", "elf_f" },
        // Mercenary & Special Operatives
        { "Doc Vance", "doc" },
        { "Sister Teresa", "angel" },
        { "Ronin Silas", "dwarf_m" },
        { "Thora Ironclad", "dwarf_f" },
        { "Pyromancer Jax", "wogol" },
        { "Gladiator Brutus", "orc_warrior" },
        { "Vespera Void", "lizard_f" },
        { "Monk Cedric", "doc" },
        { "Jack the Brawler", "pumpkin_dude" },
        { "Kaelen Shadowstep", "elf_m" },
        { "Gorzog Hex-Weaver", "orc_shaman" },
        { "Saurian Skirmisher", "lizard_m" },
        { "Masked Marauder", "masked_orc" }
    };

    // Enemy types available for spawning
    public static readonly string[] regularEnemyPrefixes = { "skelet", "goblin" };
    public static readonly string[] bossEnemyPrefixes = { "big_demon" };

    /// <summary>
    /// Register or override a hero's sprite prefix at runtime.
    /// </summary>
    public static void RegisterHero(string heroName, string spritePrefix)
    {
        if (!string.IsNullOrEmpty(heroName) && !string.IsNullOrEmpty(spritePrefix))
        {
            heroSpriteMap[heroName] = spritePrefix;
        }
    }

    /// <summary>
    /// Get the sprite prefix for a hero by their name and optional explicit prefix.
    /// Returns a fallback if not found.
    /// </summary>
    public static string GetHeroSpritePrefix(string heroName, string explicitPrefix = null)
    {
        if (!string.IsNullOrEmpty(explicitPrefix))
            return explicitPrefix;

        if (!string.IsNullOrEmpty(heroName) && heroSpriteMap.TryGetValue(heroName, out var prefix))
            return prefix;

        // Fallback based on class
        return "knight_m";
    }

    /// <summary>
    /// Get a random regular enemy sprite prefix.
    /// </summary>
    public static string GetRandomEnemyPrefix()
    {
        return regularEnemyPrefixes[Random.Range(0, regularEnemyPrefixes.Length)];
    }

    /// <summary>
    /// Get the boss sprite prefix.
    /// </summary>
    public static string GetBossPrefix()
    {
        return bossEnemyPrefixes[0];
    }
}
</file>

<file path="Assets/Scripts/Editor/EditorStartScene.cs">
using UnityEditor;
using UnityEditor.SceneManagement;
using UnityEngine;

/// <summary>
/// Forces Play Mode in the Unity Editor to always boot from Scene 0 (MainMenu),
/// preventing unintended test runs from sub-scenes like Combat or Rewards.
/// Can be toggled via Tools -> Dungeon Cleaners menu.
/// </summary>
[InitializeOnLoad]
public static class EditorStartScene
{
    private const string PREF_KEY = "DungeonCleaners_ForcePlayFromMainMenu";
    private const string MAIN_MENU_SCENE_PATH = "Assets/Scenes/MainMenu.unity";

    static EditorStartScene()
    {
        ApplyStartSceneSetting();
    }

    [MenuItem("Tools/Dungeon Cleaners/Toggle Force Start from MainMenu")]
    public static void ToggleStartFromMainMenu()
    {
        bool current = EditorPrefs.GetBool(PREF_KEY, true);
        EditorPrefs.SetBool(PREF_KEY, !current);
        ApplyStartSceneSetting();
        Debug.Log($"[EditorStartScene] Force start from MainMenu is now: {!current}");
    }

    [MenuItem("Tools/Dungeon Cleaners/Toggle Force Start from MainMenu", true)]
    public static bool ToggleStartFromMainMenuValidate()
    {
        Menu.SetChecked("Tools/Dungeon Cleaners/Toggle Force Start from MainMenu", EditorPrefs.GetBool(PREF_KEY, true));
        return true;
    }

    public static void ApplyStartSceneSetting()
    {
        bool forceMainMenu = EditorPrefs.GetBool(PREF_KEY, true);
        if (forceMainMenu)
        {
            var sceneAsset = AssetDatabase.LoadAssetAtPath<SceneAsset>(MAIN_MENU_SCENE_PATH);
            if (sceneAsset != null)
            {
                EditorSceneManager.playModeStartScene = sceneAsset;
            }
            else
            {
                Debug.LogWarning($"[EditorStartScene] Could not find scene at {MAIN_MENU_SCENE_PATH}");
            }
        }
        else
        {
            EditorSceneManager.playModeStartScene = null;
        }
    }

    [MenuItem("Tools/Dungeon Cleaners/Apply Mobile Settings")]
    public static void ApplyMobilePlayerSettings()
    {
        PlayerSettings.defaultInterfaceOrientation = UIOrientation.LandscapeLeft;
        PlayerSettings.companyName = "DungeonCleaners";
        PlayerSettings.productName = "Dungeon Cleaners";
        PlayerSettings.SetApplicationIdentifier(UnityEditor.Build.NamedBuildTarget.Android, "com.dungeoncleaners.game");
        Debug.Log("[EditorStartScene] Applied Mobile PlayerSettings: LandscapeLeft, 60fps, com.dungeoncleaners.game.");
    }
}
