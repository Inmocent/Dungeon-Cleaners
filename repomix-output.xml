                    hazardNotice = "Clear Chamber (No Traps)",
                    rewardPreview = "+45 Gold",
                    enemyCount = 3,
                    goldMultiplier = 1.0f,
                    cardAccentColor = new Color(0.22f, 0.48f, 0.75f)
